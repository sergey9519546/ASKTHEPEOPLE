# ============================================================
# ASKTHEPEOPLE — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Flask
# SECRET_KEY is required in production (stable across restarts).
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# For local development you can leave SECRET_KEY unset and set FLASK_DEBUG=true
# below — the app will auto-generate a random key per restart.
# SECRET_KEY=
SECRET_KEY=
FLASK_DEBUG=true

# ============================================================
# LLM Provider — pick ONE of the options below.
# All are OpenAI-compatible: only LLM_API_KEY / LLM_BASE_URL / LLM_MODEL_NAME change.
# ============================================================

# --- Option A: GitHub Models (RECOMMENDED — free, no sign-up) ---
# Free OpenAI-compatible inference for every GitHub account.
# Docs: https://docs.github.com/github-models
# Use the placeholder token below and the app auto-pulls a live token from
# the `gh` CLI at startup (run `gh auth login` once). On a server without `gh`,
# create a fine-grained PAT with `models:read` at https://github.com/settings/tokens
# and put it here instead of the placeholder.
# Paste your real token here, OR keep the placeholder (commented example below)
# and the app will auto-pull a live token from the local `gh` CLI at startup.
# LLM_API_KEY=gho_GITHUB_MODELS_TOKEN_PLACEHOLDER
# LLM_BASE_URL=https://models.inference.ai.azure.com
LLM_API_KEY=
LLM_BASE_URL=https://models.inference.ai.azure.com
LLM_MODEL_NAME=gpt-4o-mini
LLM_TIMEOUT=120

# Boost model (optional — used for report generation + ontology; needs a stronger model).
# Same GitHub Models endpoint + token works; gpt-4o is the stronger sibling of gpt-4o-mini.
# LLM_BOOST_API_KEY=gho_GITHUB_MODELS_TOKEN_PLACEHOLDER
# LLM_BOOST_BASE_URL=https://models.inference.ai.azure.com
LLM_BOOST_API_KEY=
LLM_BOOST_BASE_URL=https://models.inference.ai.azure.com
LLM_BOOST_MODEL_NAME=gpt-4o

# --- Option B: NVIDIA API Catalog (NIM) ---
# Sign up at https://build.nvidia.com to generate an API key.
# LLM_API_KEY=your-nvidia-api-key-here
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL_NAME=meta/llama-4-maverick-17b-128e-instruct
# LLM_BOOST_API_KEY=your-nvidia-api-key-here
# LLM_BOOST_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_BOOST_MODEL_NAME=mistralai/mistral-large-3-675b-instruct-2512

# --- Option C: OpenAI / any OpenAI-compatible provider ---
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini

# Zep Graph Memory (required)
# ZEP_API_KEY=your-zep-api-key-here
ZEP_API_KEY=

# Brave Search (optional — used by report agent)
# BRAVE_SEARCH_API_KEY=your-brave-search-api-key-here
BRAVE_SEARCH_API_KEY=


# CORS — set to your Vercel frontend URL in production.
# Leave as * for local development ONLY; never ship * in production.
# Multiple origins are comma-separated.
# CORS_ORIGINS=*
# CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
CORS_ORIGINS=

# ===== Optional: API bearer-token auth =====
# If set, all /api/* routes require:  Authorization: Bearer <APP_TOKEN>
# If unset (default), the API is open — for local development only!
# Generate a token:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# The frontend reads VITE_APP_TOKEN (build-time) or localStorage.app_token (runtime)
# and attaches the Authorization header automatically.
# APP_TOKEN=
# Frontend: expose the same token via VITE_APP_TOKEN (no frontend env section exists
# in this file yet — set it in the frontend's own .env when enabling auth).
# VITE_APP_TOKEN=

# Simulation
OASIS_DEFAULT_MAX_ROUNDS=10

# Report Agent
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
REPORT_AGENT_TEMPERATURE=0.5
REPORT_GENERATION_TIMEOUT=900

# Rate Limiting (requests per window)
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_LLM_HEAVY=10 per hour
RATELIMIT_LLM_MEDIUM=20 per hour

# Server
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
