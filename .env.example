# LLM API Configuration (supports any OpenAI-compatible LLM API)
# Recommended: OpenRouter free models, or any OpenAI-compatible provider
# Note: Heavy usage — start with simulations under 40 rounds
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b:free

# ===== ZEP Memory Graph Configuration =====
# Free tier is sufficient for basic use: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Optional: Brave Search =====
# BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
