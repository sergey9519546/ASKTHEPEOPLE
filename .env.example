# ============================================================
# ASKTHEPEOPLE — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Flask
SECRET_KEY=change-me-to-a-random-secret
FLASK_DEBUG=False

# LLM (OpenAI-compatible)
LLM_API_KEY=your-llm-api-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=your-model-name-here
LLM_TIMEOUT=120

# Boost model (optional — used for actor role when set)
# LLM_BOOST_API_KEY=
# LLM_BOOST_BASE_URL=
# LLM_BOOST_MODEL_NAME=

# Zep Graph Memory (required)
ZEP_API_KEY=your-zep-api-key-here

# Brave Search (optional — used by report agent)
BRAVE_SEARCH_API_KEY=your-brave-search-api-key-here


# CORS — set to your Vercel frontend URL in production
# Leave as * for local development
CORS_ORIGINS=*
# CORS_ORIGINS=https://your-app.vercel.app

# Simulation
OASIS_DEFAULT_MAX_ROUNDS=10

# Report Agent
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
REPORT_AGENT_TEMPERATURE=0.5
REPORT_GENERATION_TIMEOUT=900

# Rate Limiting (requests per window)
# RATELIMIT_DEFAULT=200 per day;50 per hour
# RATELIMIT_LLM_HEAVY=10 per hour
# RATELIMIT_LLM_MEDIUM=20 per hour

# Server
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
