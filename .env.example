# ============================================================
# ASKTHEPEOPLE — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Flask
# SECRET_KEY is required in production (stable across restarts).
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# For local development you can leave SECRET_KEY unset and set FLASK_DEBUG=true
# below — the app will auto-generate a random key per restart.
# SECRET_KEY=
SECRET_KEY=
FLASK_DEBUG=true

# ============================================================
# LLM Provider — pick ONE of the options below.
# All are OpenAI-compatible: only LLM_API_KEY / LLM_BASE_URL / LLM_MODEL_NAME change.
# ============================================================

# --- Option A: GitHub Models ---
# Create a credential explicitly and grant only the model-inference permission
# you need. The application never reads or reuses your local `gh auth` token.
# Docs: https://docs.github.com/github-models
LLM_API_KEY=
LLM_BASE_URL=https://models.github.ai/inference
LLM_MODEL_NAME=openai/gpt-4.1-mini
LLM_TIMEOUT=120

# Boost model (optional — used for report generation + ontology; needs a stronger model).
# Same GitHub Models endpoint + token works; GPT-4.1 is the stronger sibling.
# LLM_BOOST_BASE_URL=https://models.github.ai/inference
LLM_BOOST_API_KEY=
LLM_BOOST_BASE_URL=https://models.github.ai/inference
LLM_BOOST_MODEL_NAME=openai/gpt-4.1

# --- Option B: NVIDIA API Catalog (NIM) ---
# Sign up at https://build.nvidia.com to generate an API key.
# LLM_API_KEY=your-nvidia-api-key-here
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL_NAME=meta/llama-4-maverick-17b-128e-instruct
# LLM_BOOST_API_KEY=your-nvidia-api-key-here
# LLM_BOOST_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_BOOST_MODEL_NAME=mistralai/mistral-large-3-675b-instruct-2512

# --- Option C: OpenAI / any OpenAI-compatible provider ---
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini

# Zep Graph Memory (required)
# ZEP_API_KEY=your-zep-api-key-here
ZEP_API_KEY=

# Brave Search (optional — used by report agent)
# BRAVE_SEARCH_API_KEY=your-brave-search-api-key-here
BRAVE_SEARCH_API_KEY=


# CORS — list the exact frontend origin for local development or the reviewed
# single-host TRANSITION demo. Split-platform deployment remains disabled.
# Multiple origins are comma-separated.
# CORS_ORIGINS=https://your-frontend.example
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production Host-header allowlist. If omitted, production derives this from
# CORS_ORIGINS and Railway's injected domain variables.
# TRUSTED_HOSTS=your-frontend.example

# ===== Application access =====
# Production defaults to REQUIRE_APP_AUTH=true and refuses to start without an
# APP_TOKEN of at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Enter it in the app's access screen. Never put it in VITE_* variables:
# Vite values are public bundle contents, not secrets.
REQUIRE_APP_AUTH=false
APP_TOKEN=

# Trust X-Real-IP only behind a proxy that overwrites it. Railway enables this
# automatically through RAILWAY_ENVIRONMENT_ID; other hosts must opt in.
TRUST_X_REAL_IP=false

# Runtime provider settings are off by default. Production should use
# platform-managed secrets rather than editing .env through the browser.
ALLOW_RUNTIME_SETTINGS=false
ALLOW_PRIVATE_LLM_ENDPOINTS=false
# Comma-separated exact provider roots that runtime testing may contact.
LLM_ALLOWED_BASE_URLS=https://models.github.ai/inference

# Production clamps this to INFO or higher even if a stale value says DEBUG.
LOG_LEVEL=INFO

# Simulation
OASIS_DEFAULT_MAX_ROUNDS=10
# Synthetic run activity is stored only in the local observation store.
# Writing generated activity back to any source or synthetic graph is unsupported.

# Report Agent
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
REPORT_AGENT_TEMPERATURE=0.5
REPORT_GENERATION_TIMEOUT=900

# Rate Limiting (requests per window)
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_LLM_HEAVY=10 per hour
RATELIMIT_LLM_MEDIUM=20 per hour

# Server
FLASK_HOST=127.0.0.1
FLASK_PORT=5001

# ============================================================
# Supabase — Postgres + Storage backend
# TRANSITION / NOT RELEASE READY
# Get these from https://supabase.com/dashboard → your project
#   - Settings → API  → Project URL, anon key, service_role key
#   - Settings → Database → Connection string → URI (use the DIRECT one,
#     not the pooler, for the backend's SQLAlchemy engine)
# For local dev, run `npx supabase start` in repo root and copy the
# printed API URL / anon / service_role / DB URL here. Default local
# values are already filled in below.
# ============================================================
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# When unset, the backend falls back to local SQLite (./askthepeople.db).
# Do not treat a PostgreSQL URI here as canonical-deployment authorization;
# the migration/runtime schema and tenant-isolation gates remain unresolved.
# Examples:
#   local:   postgresql://postgres:postgres@127.0.0.1:54322/postgres
#   cloud:   postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Storage bucket names. Operators must provision and verify private buckets;
# public bucket reads bypass the intended authorization boundary.
SUPABASE_STORAGE_BUCKET_UPLOADS=askthepeople-uploads
SUPABASE_STORAGE_BUCKET_REPORTS=askthepeople-reports

# Master switch: when set to false, the backend keeps the legacy
# filesystem-backed persistence (uploads/, project.json, state.json).
# When true, the canonical store is Supabase Postgres + Storage per
# docs/architecture/adr/ADR-0012-canonical-transactional-and-object-persistence.md.
# Keep this false. The current repository has unresolved ORM/Alembic drift and
# incomplete cross-process simulation/report persistence; enabling this switch
# is not release authorization.
USE_SUPABASE_PERSISTENCE=false
