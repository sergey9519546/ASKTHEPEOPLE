<template>
  <div class="interaction-panel">
    <!-- Main Split Layout -->
    <div class="main-split-layout">
      <!-- LEFT PANEL: Report Style -->
      <div class="left-panel report-style" ref="leftPanel">
        <div v-if="reportOutline" class="report-content-wrapper">
          <!-- Report Header -->
          <div class="report-header-block">
            <div class="report-meta">
              <span class="report-tag">MiroFish Analysis</span>
              <span class="report-id">REF: {{ reportId || "RF-2024" }}</span>
            </div>
            <h1 class="main-title">{{ reportOutline.title }}</h1>
            <p class="sub-title">{{ reportOutline.summary }}</p>
          </div>

          <!-- Sections List -->
          <div class="sections-list">
            <div
              v-for="(section, idx) in reportOutline.sections"
              :key="idx"
              class="report-section-item"
              :class="{
                'is-active': currentSectionIndex === idx + 1
              }"
            >
              <div
                class="section-header-row"
                @click="toggleSectionCollapse(idx)"
              >
                <span class="section-number">{{
                  String(idx + 1).padStart(2, "0")
                }}</span>
                <h3 class="section-title">{{ section.title }}</h3>
                <span class="collapse-icon">{{ collapsedSections.has(idx) ? '+' : '−' }}</span>
              </div>

              <div class="section-body" v-show="!collapsedSections.has(idx)">
                <!-- Completed Content -->
                <div
                  v-if="generatedSections[idx + 1]"
                  class="generated-content"
                  v-html="renderMarkdown(generatedSections[idx + 1])"
                ></div>

                <!-- Loading State -->
                <div
                  v-else-if="currentSectionIndex === idx + 1"
                  class="loading-state-bauhaus"
                >
                  <div class="bauhaus-loader-dots">
                    <span></span><span></span><span></span>
                  </div>
                  <span class="loading-text">Generating {{ section.title }}...</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Waiting State -->
        <div v-if="!reportOutline" class="waiting-placeholder-bauhaus">
          <div class="bauhaus-rect-animation"></div>
          <span class="waiting-text">Awaiting Report Synthesis...</span>
        </div>
      </div>

      <!-- RIGHT PANEL: Interaction Interface -->
      <div class="right-panel" ref="rightPanel">
        <!-- Bauhaus Action Bar -->
        <div class="action-bar">
          <div class="action-bar-header">
            <div class="action-indicator"></div>
            <div class="action-bar-text">
              <span class="action-bar-title">Interactive Systems</span>
            </div>
          </div>
          <div class="action-bar-tabs">
            <button
              class="tab-pill"
              :class="{
                active: activeTab === 'chat' && chatTarget === 'report_agent',
              }"
              @click="selectReportAgentChat"
            >
              Report Agent
            </button>
            <div class="agent-dropdown" v-if="profiles.length > 0">
              <button
                class="tab-pill"
                :class="{
                  active: activeTab === 'chat' && chatTarget === 'agent',
                }"
                @click="toggleAgentDropdown"
              >
                <span>{{ selectedAgent ? selectedAgent.username : "Select Agent" }}</span>
                <span class="dropdown-arrow" :class="{ open: showAgentDropdown }">▼</span>
              </button>
              <div v-if="showAgentDropdown" class="dropdown-menu">
                <div
                  v-for="(agent, idx) in profiles"
                  :key="idx"
                  class="dropdown-item"
                  @click="selectAgent(agent, idx)"
                >
                  <div class="agent-avatar">{{ agent.username[0] }}</div>
                  <div class="agent-info">
                    <span class="agent-name">{{ agent.username }}</span>
                    <span class="agent-role">{{ agent.profession }}</span>
                  </div>
                </div>
              </div>
            </div>
            <button
              class="tab-pill"
              :class="{ active: activeTab === 'survey' }"
              @click="selectSurveyTab"
            >
              Mass Survey
            </button>
          </div>
        </div>

        <!-- Chat Mode -->
        <div v-if="activeTab === 'chat'" class="chat-container">
          <!-- Report Agent Tools -->
          <div v-if="chatTarget === 'report_agent'" class="report-agent-tools-card">
            <div class="tools-card-header">
              <div class="message-avatar">R</div>
              <div class="tools-info">
                <div class="tools-title">Synthesis Engine</div>
                <div class="tools-subtitle">4 Multi-Agent Intelligence Tools</div>
              </div>
            </div>
            <div class="tools-grid">
              <div class="tool-item">
                <div class="tool-name">InsightForge</div>
                <div class="tool-desc">Deep causal attribution analysis.</div>
              </div>
              <div class="tool-item">
                <div class="tool-name">PanoramaSearch</div>
                <div class="tool-desc">Full spectrum propagation mapping.</div>
              </div>
              <div class="tool-item">
                <div class="tool-name">QuickSearch</div>
                <div class="tool-desc">Instant graph facts retrieval.</div>
              </div>
              <div class="tool-item">
                <div class="tool-name">InterviewSubAgent</div>
                <div class="tool-desc">Autonomous person-to-person logic.</div>
              </div>
            </div>
          </div>

          <!-- Chat Messages -->
          <div class="chat-messages" ref="chatMessages">
            <div v-if="chatHistory.length === 0" class="chat-empty">
              <div class="bauhaus-empty-graphic"></div>
              <p class="empty-text">Initialize conversation with selected entity.</p>
            </div>
            <div
              v-for="(msg, idx) in chatHistory"
              :key="idx"
              class="chat-message"
              :class="msg.role"
            >
              <div class="message-avatar">
                {{ msg.role === 'user' ? 'U' : (chatTarget === 'report_agent' ? 'R' : selectedAgent?.username[0]) }}
              </div>
              <div class="message-content">
                <div class="sender-name">
                  {{ msg.role === 'user' ? 'Operator' : (chatTarget === 'report_agent' ? 'Report Agent' : selectedAgent?.username) }}
                </div>
                <div class="message-text" v-html="renderMarkdown(msg.content)"></div>
              </div>
            </div>
          </div>

          <!-- Chat Input -->
          <div class="chat-input-area">
            <textarea
              v-model="chatInput"
              class="chat-input"
              placeholder="Input query..."
              @keydown.enter.exact.prevent="sendMessage"
              :disabled="isSending"
              rows="1"
            ></textarea>
            <button
              class="send-btn"
              @click="sendMessage"
              :disabled="!chatInput.trim() || isSending"
            >
              Execute
            </button>
          </div>
        </div>

        <!-- Survey Mode -->
        <div v-if="activeTab === 'survey'" class="survey-setup">
          <div class="setup-section">
            <span class="section-title">Cohort Selection</span>
            <div class="agents-grid">
              <label
                v-for="(agent, idx) in profiles"
                :key="idx"
                class="agent-checkbox"
                :class="{ checked: selectedAgents.has(idx) }"
              >
                <input type="checkbox" :checked="selectedAgents.has(idx)" @change="toggleAgentSelection(idx)" />
                <div class="checkbox-avatar">{{ agent.username[0] }}</div>
                <div class="agent-label-info">
                  <span class="agent-label-name">{{ agent.username }}</span>
                  <span class="agent-label-role">{{ agent.profession }}</span>
                </div>
              </label>
            </div>
          </div>

          <div class="setup-section">
            <span class="section-title">Inquiry Definition</span>
            <textarea
              v-model="surveyQuestion"
              class="chat-input"
              placeholder="Define mass survey query..."
              rows="3"
            ></textarea>
          </div>

          <button
            class="survey-submit-btn"
            :disabled="selectedAgents.size === 0 || !surveyQuestion.trim() || isSurveying"
            @click="submitSurvey"
          >
            Launch Mass Survey
          </button>

          <!-- Simple Survey Results -->
          <div v-if="surveyResults.length > 0" class="survey-results-list">
            <div v-for="(result, idx) in surveyResults" :key="idx" class="result-card-bauhaus">
              <div class="result-header">
                <div class="checkbox-avatar">{{ result.agent_name[0] }}</div>
                <div class="result-meta">
                  <span class="sender-name">{{ result.agent_name }}</span>
                  <span class="agent-role">{{ result.profession }}</span>
                </div>
              </div>
              <div class="result-answer" v-html="renderMarkdown(result.answer)"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, computed, watch, onMounted, onUnmounted, nextTick } from "vue";
import { chatWithReport, getReport, getAgentLog } from "../api/report";
import {
  interviewAgents,
  getSimulationProfilesRealtime,
} from "../api/simulation";
import { marked } from "marked";

const props = defineProps({
  reportId: String,
  simulationId: String,
});

const emit = defineEmits(["add-log", "update-status"]);

// State
const activeTab = ref("chat");
const chatTarget = ref("report_agent");
const showAgentDropdown = ref(false);
const selectedAgent = ref(null);
const selectedAgentIndex = ref(null);
const showToolsDetail = ref(true);

// Chat
const chatInput = ref("");
const chatHistory = ref([]);
const chatHistoryCache = ref({});
const isSending = ref(false);
const chatMessages = ref(null);

// Survey
const selectedAgents = ref(new Set());
const surveyQuestion = ref("");
const surveyResults = ref([]);
const isSurveying = ref(false);

// Data
const reportOutline = ref(null);
const generatedSections = ref({});
const collapsedSections = ref(new Set());
const currentSectionIndex = ref(null);
const profiles = ref([]);

// Methods
const addLog = (msg) => emit("add-log", msg);

const toggleSectionCollapse = (idx) => {
  if (!generatedSections.value[idx + 1]) return;
  const newSet = new Set(collapsedSections.value);
  if (newSet.has(idx)) newSet.delete(idx);
  else newSet.add(idx);
  collapsedSections.value = newSet;
};

const saveChatHistory = () => {
  if (chatHistory.value.length === 0) return;
  const key = chatTarget.value === "report_agent" ? "report_agent" : `agent_${selectedAgentIndex.value}`;
  chatHistoryCache.value[key] = [...chatHistory.value];
};

const selectReportAgentChat = () => {
  saveChatHistory();
  activeTab.value = "chat";
  chatTarget.value = "report_agent";
  selectedAgent.value = null;
  selectedAgentIndex.value = null;
  showAgentDropdown.value = false;
  chatHistory.value = chatHistoryCache.value["report_agent"] || [];
};

const selectSurveyTab = () => {
  activeTab.value = "survey";
  showAgentDropdown.value = false;
};

const toggleAgentDropdown = () => {
  showAgentDropdown.value = !showAgentDropdown.value;
  if (showAgentDropdown.value) {
    activeTab.value = "chat";
    chatTarget.value = "agent";
  }
};

const selectAgent = (agent, idx) => {
  saveChatHistory();
  selectedAgent.value = agent;
  selectedAgentIndex.value = idx;
  chatTarget.value = "agent";
  showAgentDropdown.value = false;
  chatHistory.value = chatHistoryCache.value[`agent_${idx}`] || [];
};

const sendMessage = async () => {
  if (!chatInput.value.trim() || isSending.value) return;

  const content = chatInput.value.trim();
  chatInput.value = "";
  chatHistory.value.push({ role: "user", content, timestamp: new Date() });
  
  isSending.value = true;
  try {
    let response;
    if (chatTarget.value === "report_agent") {
      response = await chatWithReport(props.reportId, content);
    } else {
      const res = await interviewAgents(props.simulationId, content, [selectedAgentIndex.value]);
      if (res.success && res.data && res.data.length > 0) {
        response = { success: true, data: res.data[0].answer };
      }
    }

    if (response && response.success) {
      chatHistory.value.push({ role: "assistant", content: response.data, timestamp: new Date() });
    }
  } catch (err) {
    addLog(`Error communicating: ${err.message}`);
  } finally {
    isSending.value = false;
    scrollToBottom();
  }
};

const scrollToBottom = async () => {
  await nextTick();
  if (chatMessages.value) {
    chatMessages.value.scrollTop = chatMessages.value.scrollHeight;
  }
};

const toggleAgentSelection = (idx) => {
  const newSet = new Set(selectedAgents.value);
  if (newSet.has(idx)) newSet.delete(idx);
  else newSet.add(idx);
  selectedAgents.value = newSet;
};

const submitSurvey = async () => {
  if (selectedAgents.value.size === 0 || !surveyQuestion.value.trim() || isSurveying.value) return;
  
  isSurveying.value = true;
  try {
    const res = await interviewAgents(props.simulationId, surveyQuestion.value, Array.from(selectedAgents.value));
    if (res.success && res.data) {
      surveyResults.value = res.data;
    }
  } catch (err) {
    addLog(`Survey error: ${err.message}`);
  } finally {
    isSurveying.value = false;
  }
};

const renderMarkdown = (text) => marked(text);

const loadReportData = async () => {
  if (!props.reportId) return;
  try {
    const res = await getReport(props.reportId);
    if (res.success && res.data) {
      reportOutline.value = res.data;
      loadAgentLogs();
    }
  } catch (err) {
    addLog(`Load report error: ${err.message}`);
  }
};

const loadAgentLogs = async () => {
  if (!props.reportId) return;
  try {
    const res = await getAgentLog(props.reportId, 0);
    if (res.success && res.data) {
      const logs = res.data.logs || [];
      logs.forEach((log) => {
        if (log.action === "section_complete" && log.section_index < 100 && log.details?.content) {
          generatedSections.value[log.section_index] = log.details.content;
        }
      });
    }
  } catch (err) {
    addLog(`Log loading error: ${err.message}`);
  }
};

const loadProfiles = async () => {
  if (!props.simulationId) return;
  try {
    const res = await getSimulationProfilesRealtime(props.simulationId, "reddit");
    if (res.success && res.data) {
      profiles.value = res.data.profiles || [];
    }
  } catch (err) {
    addLog(`Profiles loading error: ${err.message}`);
  }
};

const handleClick = (e) => {
    const dropdown = document.querySelector(".agent-dropdown");
    if (dropdown && !dropdown.contains(e.target)) showAgentDropdown.value = false;
};

onMounted(() => {
  loadReportData();
  loadProfiles();
  document.addEventListener("click", handleClick);
});

onUnmounted(() => {
  document.removeEventListener("click", handleClick);
});

watch(() => props.reportId, (id) => id && loadReportData(), { immediate: true });
watch(() => props.simulationId, (id) => id && loadProfiles(), { immediate: true });
</script>

<style scoped>
