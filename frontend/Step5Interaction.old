}
.bauhaus-loader-dots span:nth-child(2) { background: var(--bauhaus-blue); animation-delay: 0.2s; }
.bauhaus-loader-dots span:nth-child(3) { background: var(--bauhaus-yellow); animation-delay: 0.4s; }

@keyframes bauhaus-jump {
