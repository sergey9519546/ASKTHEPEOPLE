# Production Environment Variables Template
# Copy this to your Railway/Render dashboard environment settings

# Required: Flask security
SECRET_KEY=your-random-32+-char-secret-key-here
FLASK_DEBUG=false

# Required: API authentication (set to enable auth, leave empty to disable)
APP_TOKEN=your-bearer-token-here

# Required: LLM provider
LLM_API_KEY=your-openai-or-compatible-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# Optional: Boost model for report generation
LLM_BOOST_API_KEY=your-boost-api-key-if-different
LLM_BOOST_BASE_URL=https://api.openai.com/v1
LLM_BOOST_MODEL_NAME=gpt-4o

# Required: Zep Cloud for graph memory
ZEP_API_KEY=your-zep-cloud-api-key

# Optional: Brave Search for report agent web search
BRAVE_SEARCH_API_KEY=your-brave-search-api-key

# Required: CORS (Railway auto-injects RAILWAY_PUBLIC_DOMAIN, but you can override)
CORS_ORIGINS=https://your-frontend-domain.com,https://your-railway-domain.up.railway.app

# Required: Redis for Celery (Railway auto-injects when you add Redis plugin)
REDIS_URL=redis://default:password@redis.railway.internal:6379

# Optional: Runtime settings mutations (requires APP_TOKEN in production)
ALLOW_RUNTIME_SETTINGS=false
ALLOW_PRIVATE_LLM_ENDPOINTS=false

# Optional: Sentry error tracking
SENTRY_DSN=your-sentry-dsn-here

# Optional: Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Optional: Database (currently unused, filesystem storage is active)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Note: Railway auto-injects these variables (do not set manually):
# - PORT
# - RAILWAY_ENVIRONMENT_ID
# - RAILWAY_PUBLIC_DOMAIN
# - RAILWAY_PRIVATE_DOMAIN
# - RAILWAY_STATIC_URL
