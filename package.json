{
  "name": "askthepeople",
  "version": "0.1.0",
  "description": "ASKTHEPEOPLE - Synthetic Scenario Explorer",
  "scripts": {
    "setup": "npm ci --no-audit --no-fund && npm --prefix frontend ci --no-audit --no-fund",
    "setup:backend": "cd backend && uv sync --frozen --extra dev",
    "setup:all": "npm run setup && npm run setup:backend",
    "dev": "concurrently --kill-others -n \"backend,frontend\" -c \"green,cyan\" \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && uv run python run.py",
    "backend:test": "cd backend && uv run --frozen pytest -q",
    "frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend test --silent",
    "verify": "npm run test && npm run build && npm run backend:test"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "license": "AGPL-3.0"
}
