# Single-host TRANSITION demo only. Copy to .env.transition and fill every
# required blank with a newly issued value. Do not copy values from .env or
# repository history; the previously configured provider credentials require
# provider-side revocation and rotation before any connected run.

SECRET_KEY=
APP_TOKEN=
REQUIRE_APP_AUTH=true
FLASK_DEBUG=false

# Current no-charge demo candidates, not an availability or quality promise.
# Verify that the account is still on Groq's Free plan before every run.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=llama-3.1-8b-instant
# Optional. Leave blank to reuse the primary model credentials.
LLM_BOOST_API_KEY=
LLM_BOOST_BASE_URL=https://api.groq.com/openai/v1
LLM_BOOST_MODEL_NAME=openai/gpt-oss-120b
ZEP_API_KEY=
# Optional. Leave blank unless the bounded demo explicitly enables web search.
BRAVE_SEARCH_API_KEY=

# Replace these with the exact HTTPS origin and host issued by the tunnel.
CORS_ORIGINS=https://replace-with-demo-host.example
TRUSTED_HOSTS=replace-with-demo-host.example
TRUST_X_REAL_IP=false

ALLOW_RUNTIME_SETTINGS=false
ALLOW_PRIVATE_LLM_ENDPOINTS=false
LOG_LEVEL=INFO

# Explicitly keep this demo on the shared single-host filesystem. This is not
# the TARGET canonical PostgreSQL/object-store architecture.
USE_SUPABASE_PERSISTENCE=false
DATABASE_URL=sqlite:////app/backend/uploads/transition.db
